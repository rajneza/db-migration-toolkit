# ============================================================================
# STAGING DATABASE (Source)
# ============================================================================
STAGING_HOST=your-staging-host.rds.amazonaws.com
STAGING_PORT=5432
STAGING_DB=staging_database
STAGING_USER=postgres
STAGING_PASSWORD=your-staging-password
STAGING_SCHEMA=staging

# ============================================================================
# DEV DATABASE (Target - New Server)
# ============================================================================
DEV_HOST=your-new-dev-host.rds.amazonaws.com
DEV_PORT=5432
DEV_DB=dev_database
DEV_USER=postgres
DEV_PASSWORD=your-dev-password
DEV_SCHEMA=public

# ============================================================================
# MIGRATION OPTIONS
# ============================================================================
# Create backup before migration? (true/false)
CREATE_BACKUP=true

# Backup directory (relative or absolute path)
BACKUP_DIR=./backups

# Skip validation after migration? (true/false)
SKIP_VALIDATION=false

# Verbose logging? (true/false)
VERBOSE=true
